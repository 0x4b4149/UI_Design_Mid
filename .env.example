# Copy this file to .env and fill in your own values. Never commit .env.
SECRET_KEY=replace-me-with-a-long-random-string
DEBUG=True

# Leave empty to use the local SQLite database.
# Neon example (use the pooled connection string):
# DATABASE_URL=postgresql://neondb_owner:password@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=False
